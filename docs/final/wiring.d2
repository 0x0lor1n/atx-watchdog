direction: right
style.fill: "#16161d"

classes: {
  board: {style: {fill: "#1f1f28"; stroke: "#7e9cd8"; font-color: "#dcd7ba"; stroke-width: 2; border-radius: 6; bold: true}}
  pin: {style: {fill: "#2a2a37"; stroke: "#54546d"; font-color: "#dcd7ba"; font-size: 20}}
  part: {style: {fill: "#2a2a37"; stroke: "#98bb6c"; font-color: "#dcd7ba"; font-size: 20}}
  pwr: {style: {stroke: "#ff5d62"; stroke-width: 3; font-color: "#ff5d62"}}
  gnd: {style: {stroke: "#727169"; stroke-width: 3; font-color: "#727169"}}
  data: {style: {stroke: "#e6c384"; stroke-width: 3; font-color: "#e6c384"}}
  ctl: {style: {stroke: "#7fb4ca"; stroke-width: 3; font-color: "#7fb4ca"}}
  btn: {style: {stroke: "#98bb6c"; stroke-width: 3; font-color: "#98bb6c"}}
}

title: "FINAL: JCOM1 -> inverter -> Pro Micro -> BC547 -> JFP1" {
  near: top-center
  shape: text
  style: {font-color: "#dcd7ba"; font-size: 30; bold: true}
}

mb: "MSI B250M PRO-VD" {
  class: board
  atx: "24-pin ATX" {
    class: board
    p9: "pin 9  5VSB (+5 V)" {class: pin}
    p7: "pin 7  GND" {class: pin}
  }
  com: "JCOM1" {
    class: board
    p3: "pin 3  SOUT (TX, ±12 V)" {class: pin}
    p5: "pin 5  GND" {class: pin}
  }
  jfp: "JFP1" {
    class: board
    hot: "PWR SW 'hot' pin (~3.3 V, measure: 6 or 8)" {class: pin}
    gnd: "PWR SW other pin = GND, leave unconnected" {class: pin}
  }
}

lvl: "RS-232 -> TTL (inverter)" {
  class: board
  r1: "R1 10k  (to base)" {class: part}
  d1: "D1 1N4148/1N4007  base-GND, cathode on base" {class: part}
  q1: "Q1 BC547  E = GND" {class: part}
  r2: "R2 10k  collector pull-up to 5 V" {class: part}
}

pm: "Pro Micro 5 V / 16 MHz" {
  class: board
  vcc: "VCC" {class: pin}
  gnd: "GND" {class: pin}
  rx: "pin 0  RX (Serial1)" {class: pin}
  p4: "pin 4  -> Q2 (HIGH = press)" {class: pin}
  usb: "USB: flashing / debug only" {class: pin}
}

sw: "button switch" {
  class: board
  r3: "R3 2.2k  pin 4 -> base" {class: part}
  r4: "R4 10k  base -> GND (off while flashing)" {class: part}
  q2: "Q2 BC547  E = GND" {class: part}
}

mb.com.p3 -> lvl.r1: "SOUT" {class: data}
lvl.r2 -> pm.rx: "clean 0/5 V" {class: data}
mb.atx.p9 -> pm.vcc: "5VSB" {class: pwr}
mb.atx.p9 -> lvl.r2: "5 V" {class: pwr}
mb.atx.p7 -> pm.gnd: "GND" {class: gnd}
mb.com.p5 -> lvl.q1: "GND" {class: gnd}
mb.atx.p7 -> sw.q2: "GND" {class: gnd}
pm.p4 -> sw.r3: "HIGH = pressed" {class: ctl}
sw.q2 -> mb.jfp.hot: "Q2 collector pulls PWR SW to GND" {class: btn}

note: "all GNDs are one common ground (ATX pin 7 = JCOM1 pin 5 = PWR SW GND pin)\nfirmware: flash-transistor (BUTTON_ACTIVE_HIGH)" {
  near: bottom-center
  shape: text
  style: {font-color: "#e6c384"; font-size: 24; italic: true}
}
